# --- Tailscale ---
# Pre-auth key for the tailnet. Generate in https://login.tailscale.com/admin/settings/keys
# (tags or user-attached; a reusable key is fine). The container joins as hostname "romm".
TAILSCALE_AUTH_KEY=

# --- Database ---
ROMM_DB_ROOT_PASSWORD=change-me-root
ROMM_DB_PASSWORD=change-me-romm

# --- RomM ---
# Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# --- Metadata providers (optional; HASHEOUS is enabled by default and needs no key) ---
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=

# --- Metadata provider toggles ---
# Enable HowLongToBeat completion times (no key required)
HLTB_API_ENABLED=false

# --- Storage (defaults to /srv/romm on the host; override if ROMs live elsewhere) ---
ROMM_LIBRARY_DIR=/srv/romm/library
ROMM_ASSETS_DIR=/srv/romm/assets
ROMM_CONFIG_DIR=/srv/romm/config
